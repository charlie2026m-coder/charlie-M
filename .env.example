# App
NEXT_PUBLIC_BASE_URL=https://www.charlie-m.de
NEXT_PUBLIC_SITE_URL=https://www.charlie-m.de

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Apaleo (PMS)
APALEO_CLIENT_ID=
APALEO_CLIENT_SECRET=
APALEO_PROPERTY_ID=CMH
APALEO_ACCOUNT_ID=RKAA

# Adyen (Payments)
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_SUB_MERCHANT_ID=
NEXT_PUBLIC_ADYEN_CLIENT_KEY=
NEXT_PUBLIC_ADYEN_ENVIRONMENT=test

# Adyen Live (fill after live account activation)
ADYEN_LIVE_URL_PREFIX=
ADYEN_HMAC_KEY=

# Guestway (PIN codes / pre-check-in)
GUESTWAY_API_URL=https://open-api.guestway.io/api/open/v1
GUESTWAY_API_KEY=
GUESTWAY_ACCESS_TOKEN=

# Room-Ready door opening (app/api/guestway/room-ready). The Guestway "Room Ready"
# automation messages TODAY'S arriving guest at max(13:00, room-cleaned) and calls
# this webhook at the same moment; we amend the Apaleo arrival to that time so the
# smart-lock code re-syncs and the door opens. Floor = 13:00, never earlier.
#   ENABLED — master kill switch; must be exactly "true" to act (default = safe no-op).
#   SECRET  — shared secret; put the SAME value in the Guestway webhook URL as ?key=<secret>.
GUESTWAY_ROOM_READY_ENABLED=
GUESTWAY_ROOM_READY_SECRET=

# Vapi voice agent — bearer key for the public availability endpoint
# (app/api/availability). The voice assistant calls GET/POST /api/availability
# with Authorization: Bearer <this> to read live room availability + prices
# (wraps Apaleo /booking/v1/offers server-side; Apaleo creds never leave here).
VAPI_AVAILABILITY_KEY=

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Places (server-side, for fetching reviews)
GOOGLE_PLACES_API_KEY=

# Google Analytics 4 + Google Ads
NEXT_PUBLIC_GA_MEASUREMENT_ID=          # G-XXXXXXXXXX (GA4 Admin > Data Streams)
NEXT_PUBLIC_GOOGLE_ADS_ID=              # AW-XXXXXXXXXX (Google Ads > Goals > Conversions)
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=  # Conversion label for purchase event
NEXT_PUBLIC_APALEO_PROPERTY_ID=CMH      # Property ID for Google Hotel Ads attribution
